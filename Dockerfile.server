# tam-server: the shared database several clients talk to in remote mode.
# Build from the repository root:  docker build -f Dockerfile.server -t tam-server .

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tam-server ./cmd/tam-server

FROM alpine:3.20
RUN mkdir -p /data
ENV TAM_DATA_DIR=/data
COPY --from=build /out/tam-server /tam-server
EXPOSE 8000
VOLUME ["/data"]
ENTRYPOINT ["/tam-server"]
