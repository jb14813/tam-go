# tam-client: the web app plus its API, for a venue laptop or a small box.
# Build from the repository root:  docker build -f Dockerfile.client -t tam-client .

FROM node:24-alpine AS web
WORKDIR /src/frontend
RUN npm install -g pnpm@12
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
# adapter-static writes to ../cmd/tam-client/dist, so create the target.
RUN mkdir -p /src/cmd/tam-client && pnpm build

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/cmd/tam-client/dist ./cmd/tam-client/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tam-client ./cmd/tam-client

FROM alpine:3.20
RUN mkdir -p /data
ENV TAM_DATA_DIR=/data
COPY --from=build /out/tam-client /tam-client
EXPOSE 3080
VOLUME ["/data"]
ENTRYPOINT ["/tam-client", "-addr", ":3080"]
