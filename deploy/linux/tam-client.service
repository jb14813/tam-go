# tam-client as a system service: the web app on port 3080, against a local
# database in /var/lib/tam-client or, once paired from its Settings page, a
# tam-server. install.sh next to this file installs it.
#
# This is for a machine that should serve the web app all the time. On a
# computer used by one person, running ./tam-client by hand (or from the
# application-menu entry) is simpler: it opens the browser itself and stops
# from Alt+A, Shut Down TAM. With -addr :3080 the app is reachable from
# other machines too, as the container of the original was; use
# -addr localhost:3080 to keep it to this machine.

[Unit]
Description=Ticket Auction Manager client
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=tam
Group=tam
Environment=TAM_DATA_DIR=/var/lib/tam-client
ExecStart=/usr/local/bin/tam-client -addr :3080 -open=false -tray=false
Restart=on-failure
RestartSec=3
# SIGTERM stops the program the same way Ctrl+C does.
KillSignal=SIGTERM
TimeoutStopSec=15

# The program needs its data directory and nothing else: the rest of the
# system is read-only or hidden from it.
StateDirectory=tam-client
ReadWritePaths=/var/lib/tam-client
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
